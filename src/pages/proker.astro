---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { X, ChevronRight, Plus, Edit, Trash2, Newspaper } from "lucide-astro";
import { readCloudDB } from "../lib/db.js";
import defaultNewsData from "../../database/news.json";
import defaultSettingsData from "../../database/settings.json";

const { data: newsListRaw } = await readCloudDB("news", defaultNewsData);
const { data: siteSettingsRaw } = await readCloudDB(
  "settings",
  defaultSettingsData,
);

const newsList = Array.isArray(newsListRaw) ? newsListRaw : [];
const komisiList: { code: string; title: string }[] =
  siteSettingsRaw?.orgStructure?.komisi ||
  defaultSettingsData?.orgStructure?.komisi ||
  [];
---

<Layout
  title="Berita - DMFK UM"
  description="Berita, dokumentasi acara, dan publikasi kegiatan terkini dari berbagai komisi DMFK UM."
>
  <div class="py-16 px-4 max-w-7xl mx-auto animate-fade-in pb-24">
    <div
      class="mb-16 flex flex-col md:flex-row justify-between items-start md:items-end gap-6"
    >
      <div>
        <h1
          class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight"
        >
          Berita
        </h1>
        <p class="text-gray-500 text-lg max-w-2xl font-medium">
          Jelajahi galeri program kerja, dokumentasi acara, dan publikasi
          kegiatan terkini dari berbagai divisi.
        </p>
      </div>
      <button
        id="add-news-btn"
        class="admin-only hidden flex items-center gap-2 bg-rose-600 text-white px-6 py-3 rounded-full font-bold hover:bg-rose-700 transition-colors shadow-lg shadow-rose-600/20 shrink-0 cursor-pointer outline-none"
      >
        <Plus class="h-5 w-5" /> Tambah Berita
      </button>
    </div>

    {/* News Grid (Click to open preview modal) */}
    <div
      id="news-grid-container"
      class={newsList.length > 0 ? "grid grid-cols-1 md:grid-cols-2 gap-8 mb-24" : "w-full mb-24"}
      data-initial={JSON.stringify(newsList)}
    >
      {
        newsList.length > 0 ? (
          newsList.map((news) => (
            <div
              class="news-card group flex flex-col sm:flex-row bg-white rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-xl border border-gray-50 overflow-hidden transition-all duration-300 hover:-translate-y-1 cursor-pointer"
              data-id={news.id}
            >
              <div class="sm:w-2/5 relative overflow-hidden">
                <img
                  src={news.image}
                  alt={news.title}
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80';"
                  class="news-card-img w-full h-full object-cover min-h-[200px] group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />

                {/* Admin actions overlay */}
                <div class="admin-only hidden absolute top-4 right-4 flex flex-col gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10">
                  <button
                    class="edit-news-btn p-2 bg-white/90 backdrop-blur-md rounded-xl text-blue-600 hover:bg-blue-50 hover:scale-110 transition-all shadow-sm cursor-pointer outline-none"
                    data-id={news.id}
                  >
                    <Edit class="h-4 w-4" />
                  </button>
                  <button
                    class="delete-news-btn p-2 bg-white/90 backdrop-blur-md rounded-xl text-rose-600 hover:bg-rose-50 hover:scale-110 transition-all shadow-sm cursor-pointer outline-none"
                    data-id={news.id}
                  >
                    <Trash2 class="h-4 w-4" />
                  </button>
                </div>
              </div>
              <div class="p-6 sm:w-3/5 flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs font-bold px-3 py-1.5 bg-rose-50 text-rose-700 rounded-full">
                    {news.category}
                  </span>
                  <span class="text-xs font-medium text-gray-400">
                    {news.date}
                  </span>
                </div>
                <h3 class="font-extrabold text-xl text-gray-900 mb-3 leading-tight group-hover:text-rose-700 transition-colors">
                  {news.title}
                </h3>
                <p class="text-gray-500 text-sm mb-5 line-clamp-2 leading-relaxed">
                  {news.excerpt}
                </p>
                <div class="flex flex-wrap gap-2 mt-auto mb-3">
                  {news.tags.map((tag) => (
                    <span class="text-[10px] font-bold text-gray-400 bg-gray-100/80 px-2.5 py-1 rounded-md uppercase tracking-wider">
                      #{tag}
                    </span>
                  ))}
                </div>
                <button class="text-rose-600 font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all outline-none">
                  Selengkapnya <ChevronRight class="h-4 w-4" />
                </button>
              </div>
            </div>
          ))
        ) : (
          <div class="bg-gradient-to-br from-white via-rose-50/20 to-gray-50/50 rounded-[2.5rem] border border-dashed border-rose-200/80 p-8 sm:p-12 text-center shadow-[0_4px_25px_rgb(0,0,0,0.02)] flex flex-col items-center justify-center max-w-2xl mx-auto">
            <div class="w-16 h-16 rounded-2xl bg-rose-50 border border-rose-100/80 flex items-center justify-center text-rose-600 mb-4 shadow-inner">
              <Newspaper class="h-8 w-8" />
            </div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-gray-900 mb-2">
              Belum Ada Berita Terpublikasi
            </h3>
            <p class="text-gray-500 text-sm sm:text-base max-w-lg mx-auto mb-6 leading-relaxed font-normal">
              Liputan program kerja, dokumentasi kegiatan, dan publikasi resmi DMFK UM akan ditampilkan di sini.
            </p>
            <button
              id="empty-add-news-btn"
              class="admin-only hidden inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 text-white hover:bg-rose-700 font-bold rounded-xl text-sm shadow-md shadow-rose-600/20 transition-all cursor-pointer"
            >
              <Plus class="h-4 w-4" /> Tulis Berita Pertama
            </button>
          </div>
        )
      }
    </div>

    {/* --- MODALS --- */}

    {/* Shared News Preview Modal */}
    <dialog
      id="news-preview-modal"
      closedby="any"
      class="fixed inset-0 bg-transparent p-4 border-none outline-none open:flex justify-center items-center backdrop:bg-gray-900/80 backdrop:backdrop-blur-sm"
    >
      <div
        class="modal-content bg-white w-full max-w-4xl h-[90vh] rounded-[2rem] flex flex-col shadow-2xl overflow-hidden relative border border-gray-100"
      >
        {/* Modal Header */}
        <div
          class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-white z-10 shadow-sm shrink-0"
        >
          <div class="flex items-center gap-4">
            <span
              id="preview-category"
              class="text-xs font-bold px-3 py-1.5 bg-rose-50 text-rose-700 rounded-full"
            ></span>
            <span id="preview-date" class="text-sm font-medium text-gray-500"
            ></span>
          </div>
          <button
            id="close-preview-btn"
            class="p-2.5 hover:bg-gray-100 rounded-full text-gray-500 transition-colors outline-none cursor-pointer"
          >
            <X class="h-6 w-6" />
          </button>
        </div>

        {/* Content Area */}
        <div class="flex-1 overflow-y-auto p-0 bg-white">
          <div class="relative h-64 sm:h-96 w-full">
            <img
              id="preview-image"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"
            >
            </div>
          </div>

          <div
            class="p-6 sm:p-12 -mt-20 relative z-10 bg-white rounded-t-[3rem]"
          >
            <h2
              id="preview-title"
              class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-6 leading-tight tracking-tight text-gray-900"
            >
            </h2>

            <div
              id="preview-tags"
              class="flex flex-wrap gap-2 mb-8 border-b border-gray-100 pb-8"
            >
            </div>

            <div
              class="text-gray-600 font-medium leading-relaxed space-y-6 text-lg"
            >
              <p
                id="preview-excerpt"
                class="text-xl text-gray-800 font-semibold mb-4 leading-snug"
              >
              </p>
              <div id="preview-content" class="space-y-4 text-gray-700">
                {/* Loaded dynamically */}
              </div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    {/* Modal Form Tambah/Edit Berita */}
    <dialog
      id="news-form-modal"
      closedby="any"
      class="fixed inset-0 bg-transparent p-4 border-none outline-none open:flex justify-center items-center backdrop:bg-gray-900/80 backdrop:backdrop-blur-sm"
    >
      <div
        class="bg-white w-full max-w-2xl rounded-[2.5rem] p-8 shadow-2xl relative border border-gray-100 max-h-[90vh] overflow-y-auto"
      >
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2
              id="form-modal-title"
              class="text-2xl font-extrabold text-gray-900"
            >
              Tambah Berita
            </h2>
            <p class="text-sm font-medium text-gray-500 mt-1">
              Lengkapi data berita di bawah ini.
            </p>
          </div>
          <button
            id="close-news-form-btn"
            class="p-2 bg-gray-50 hover:bg-gray-100 rounded-full text-gray-400 transition-colors cursor-pointer outline-none"
          >
            <X class="h-5 w-5" />
          </button>
        </div>

        <form id="news-form" class="space-y-5">
          <input type="hidden" id="news-form-id" />
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >Judul Berita</label
            >
            <input
              required
              type="text"
              id="news-form-title"
              placeholder="Masukkan judul berita"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2"
                >Kategori</label
              >
              <select
                required
                id="news-form-category"
                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 cursor-pointer"
              >
                <option value="" disabled selected>Pilih Kategori</option>
                <option value="Umum">Umum</option>
                {
                  komisiList.map((k) => (
                    <option value={`${k.code} – ${k.title}`}>
                      {k.code} – {k.title}
                    </option>
                  ))
                }
              </select>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2"
                >Tanggal</label
              >
              <input
                required
                type="text"
                id="news-form-date"
                placeholder="Contoh: 15 Jan 2026"
                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
              />
            </div>
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >Tags (pisahkan dengan koma)</label
            >
            <input
              required
              type="text"
              id="news-form-tags"
              placeholder="Contoh: Kebijakan, Kampus, Mahasiswa"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >Upload Thumbnail/Foto Berita</label
            >
            <input
              type="file"
              id="news-form-image-file"
              accept="image/*"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 cursor-pointer"
            />
            <p class="text-xs text-gray-400 mt-1">
              Gambar akan diunggah dan disimpan ke folder server <code
                >public/uploads/</code
              >.
            </p>
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >URL Gambar (Opsional jika mengunggah file)</label
            >
            <input
              type="text"
              id="news-form-image"
              placeholder="Masukkan URL gambar jika ada"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >Ringkasan Singkat (Excerpt)</label
            >
            <textarea
              required
              id="news-form-excerpt"
              rows="2"
              placeholder="Tuliskan ringkasan singkat..."
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 resize-none"
            ></textarea>
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2"
              >Konten Lengkap Berita</label
            >
            <textarea
              required
              id="news-form-content"
              rows="4"
              placeholder="Tuliskan isi lengkap berita..."
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full mt-6 py-4 bg-rose-600 text-white rounded-xl font-bold hover:bg-rose-700 shadow-lg shadow-rose-600/20 hover:shadow-rose-600/40 hover:-translate-y-0.5 transition-all text-lg cursor-pointer"
          >
            Simpan Berita
          </button>
        </form>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  interface NewsItem {
    id: number;
    title: string;
    category: string;
    date: string;
    excerpt: string;
    image: string;
    tags: string[];
    content?: string;
  }

  function setupProkerInteractions() {
    const container = document.getElementById("news-grid-container");
    const isAdmin = localStorage.getItem("isAdmin") === "true";

    // Show/Hide Admin Controls globally
    const adminControls = document.querySelectorAll(".admin-only");
    adminControls.forEach((el) => {
      if (isAdmin) {
        el.classList.remove("hidden");
      } else {
        el.classList.add("hidden");
      }
    });

    if (!container) return;

    // Load pre-rendered news from initial-data attribute
    const initialData = container.getAttribute("data-initial") || "[]";
    let newsList: NewsItem[] = JSON.parse(initialData);

    function escapeHtml(str: string): string {
      if (!str) return "";
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function renderNewsCards(items: NewsItem[]) {
      if (!container) return;
      if (!Array.isArray(items) || items.length === 0) {
        container.className = "w-full mb-24";
        container.innerHTML = `
          <div class="bg-gradient-to-br from-white via-rose-50/20 to-gray-50/50 rounded-[2.5rem] border border-dashed border-rose-200/80 p-8 sm:p-12 text-center shadow-[0_4px_25px_rgb(0,0,0,0.02)] flex flex-col items-center justify-center max-w-2xl mx-auto">
            <div class="w-16 h-16 rounded-2xl bg-rose-50 border border-rose-100/80 flex items-center justify-center text-rose-600 mb-4 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/></svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-gray-900 mb-2">
              Belum Ada Berita Terpublikasi
            </h3>
            <p class="text-gray-500 text-sm sm:text-base max-w-lg mx-auto mb-6 leading-relaxed font-normal">
              Liputan program kerja, dokumentasi kegiatan, dan publikasi resmi DMFK UM akan ditampilkan di sini.
            </p>
            <button
              id="empty-add-news-btn"
              class="admin-only ${isAdmin ? "" : "hidden"} inline-flex items-center gap-2 px-5 py-2.5 bg-rose-600 text-white hover:bg-rose-700 font-bold rounded-xl text-sm shadow-md shadow-rose-600/20 transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> Tulis Berita Pertama
            </button>
          </div>
        `;
        const emptyAddBtn = document.getElementById("empty-add-news-btn");
        if (emptyAddBtn) {
          emptyAddBtn.addEventListener("click", () => openFormModal(null));
        }
        return;
      }
      container.className = "grid grid-cols-1 md:grid-cols-2 gap-8 mb-24";
      container.innerHTML = items
        .map(
          (news) => `
        <div class="news-card group flex flex-col md:flex-row bg-white rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-xl border border-gray-100 overflow-hidden transition-all duration-300 hover:-translate-y-1 cursor-pointer w-full min-h-[240px]" data-id="${escapeHtml(String(news.id))}">
          <div class="md:w-2/5 h-52 md:h-auto relative overflow-hidden shrink-0 bg-gray-100">
            <img src="${escapeHtml(news.image || 'https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80')}" alt="${escapeHtml(news.title)}" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80';" class="news-card-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            <div class="admin-only ${isAdmin ? "" : "hidden"} absolute top-4 right-4 flex flex-col gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10">
              <button class="edit-news-btn p-2 bg-white/90 backdrop-blur-md rounded-xl text-blue-600 hover:bg-blue-50 hover:scale-110 transition-all shadow-sm cursor-pointer outline-none" data-id="${escapeHtml(String(news.id))}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button class="delete-news-btn p-2 bg-white/90 backdrop-blur-md rounded-xl text-rose-600 hover:bg-rose-50 hover:scale-110 transition-all shadow-sm cursor-pointer outline-none" data-id="${escapeHtml(String(news.id))}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              </button>
            </div>
          </div>
          <div class="p-6 md:w-3/5 flex flex-col justify-between flex-1">
            <div>
              <div class="flex items-center gap-3 mb-2.5">
                <span class="text-xs font-bold px-3 py-1 bg-rose-50 text-rose-700 rounded-full shrink-0">${escapeHtml(news.category)}</span>
                <span class="text-xs font-medium text-gray-400 shrink-0">${escapeHtml(news.date)}</span>
              </div>
              <h3 class="font-extrabold text-lg sm:text-xl text-gray-900 mb-2 leading-snug line-clamp-2 group-hover:text-rose-700 transition-colors">${escapeHtml(news.title)}</h3>
              <p class="text-gray-500 text-sm mb-4 line-clamp-2 leading-relaxed">${escapeHtml(news.excerpt || "")}</p>
            </div>
            <div>
              <div class="flex flex-wrap gap-1.5 mb-3">
                ${(news.tags || []).map((tag: string) => `<span class="text-[10px] font-bold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-md uppercase tracking-wider">#${escapeHtml(tag)}</span>`).join("")}
              </div>
              <div class="text-rose-600 font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
                Baca Selengkapnya <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            </div>
          </div>
        </div>
      `,
        )
        .join("");
    }

    // ✅ Apply any admin edits stored in localStorage
    const cachedNews = localStorage.getItem("dmfk_news");
    if (cachedNews) {
      try {
        newsList = JSON.parse(cachedNews);
        renderNewsCards(newsList);
      } catch (e) {
        console.error("Failed to parse cached news:", e);
      }
    }

    function updateCategoryDropdown(komisiData?: any[]) {
      const select = document.getElementById(
        "news-form-category",
      ) as HTMLSelectElement | null;
      if (!select) return;
      let list = komisiData;
      if (!list) {
        try {
          const cachedSettings = JSON.parse(
            localStorage.getItem("dmfk_settings") || "{}",
          );
          if (cachedSettings?.orgStructure?.komisi) {
            list = cachedSettings.orgStructure.komisi;
          }
        } catch (e) {}
      }
      if (Array.isArray(list) && list.length > 0) {
        const currentValue = select.value;
        const optionsHtml = [
          '<option value="" disabled selected>Pilih Kategori</option>',
          '<option value="Umum">Umum</option>',
          ...list.map(
            (k: any) =>
              `<option value="${k.code} – ${k.title}">${k.code} – ${k.title}</option>`,
          ),
        ].join("");
        select.innerHTML = optionsHtml;
        if (currentValue) select.value = currentValue;
      }
    }

    updateCategoryDropdown();

    fetch("/api/settings")
      .then((res) => (res.ok ? res.json() : null))
      .then((resData) => {
        if (
          resData &&
          resData.settings &&
          resData.settings.orgStructure?.komisi
        ) {
          const current = JSON.parse(
            localStorage.getItem("dmfk_settings") || "{}",
          );
          const localTime = Number(current._updatedAt) || 0;
          const serverTime = Number(resData.settings._updatedAt) || 0;
          let merged;
          if (resData.isCloud) {
            merged = serverTime >= localTime ? { ...current, ...resData.settings } : { ...resData.settings, ...current };
          } else {
            merged = (localTime > 0 && localTime >= serverTime) ? { ...resData.settings, ...current } : { ...current, ...resData.settings };
          }
          try {
            localStorage.setItem("dmfk_settings", JSON.stringify(merged));
          } catch (_) {}
          updateCategoryDropdown(merged.orgStructure?.komisi || resData.settings.orgStructure.komisi);
        }
      })
      .catch(() => {});

    // 🌐 Fetch latest from cloud server database to sync across all devices
    fetch("/api/news")
      .then((res) => (res.ok ? res.json() : null))
      .then((resData) => {
        if (resData && Array.isArray(resData.news)) {
          localStorage.setItem("dmfk_news", JSON.stringify(resData.news));
          newsList = resData.news;
          renderNewsCards(newsList);
          checkAutoOpen();
        }
      })
      .catch(() => {});

    // Preview Modal logic
    const previewModal = document.getElementById(
      "news-preview-modal",
    ) as HTMLDialogElement | null;
    const closePreviewBtn = document.getElementById("close-preview-btn");

    function openPreviewModal(news: NewsItem) {
      if (!previewModal) return;

      const categoryEl = document.getElementById("preview-category");
      const dateEl = document.getElementById("preview-date");
      const titleEl = document.getElementById("preview-title");
      const imageEl = document.getElementById(
        "preview-image",
      ) as HTMLImageElement | null;
      const tagsEl = document.getElementById("preview-tags");
      const excerptEl = document.getElementById("preview-excerpt");
      const contentEl = document.getElementById("preview-content");

      if (categoryEl) categoryEl.textContent = news.category;
      if (dateEl) dateEl.textContent = news.date;
      if (titleEl) titleEl.textContent = news.title;
      if (imageEl) {
        imageEl.src = news.image || "https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80";
        imageEl.alt = news.title;
        imageEl.onerror = () => {
          imageEl.onerror = null;
          imageEl.src = "https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80";
        };
      }
      if (excerptEl) excerptEl.textContent = news.excerpt;

      if (tagsEl) {
        tagsEl.innerHTML = news.tags
          .map(
            (tag) => `
          <span class="text-xs font-bold text-gray-500 bg-gray-100 px-3 py-1.5 rounded-lg uppercase tracking-wider">#${escapeHtml(tag)}</span>
        `,
          )
          .join("");
      }

      if (contentEl) {
        contentEl.innerHTML = "";
        if (news.content) {
          const paragraphs = news.content.split("\n").filter((p) => p.trim());
          paragraphs.forEach((p) => {
            const pEl = document.createElement("p");
            pEl.textContent = p;
            contentEl.appendChild(pEl);
          });
        }
      }

      previewModal.showModal();
      document.body.classList.add("overflow-hidden");
    }

    if (previewModal) {
      const closeHandler = () => {
        previewModal.close();
        document.body.classList.remove("overflow-hidden");
      };

      if (closePreviewBtn) closePreviewBtn.addEventListener("click", closeHandler);
      previewModal.addEventListener("click", (event) => {
        if (event.target === previewModal) closeHandler();
      });
      previewModal.addEventListener("close", () => {
        document.body.classList.remove("overflow-hidden");
      });
      previewModal.addEventListener("cancel", () => {
        document.body.classList.remove("overflow-hidden");
      });
    }

    // Auto-open modal if URL specifies ?id=... or #news-...
    function checkAutoOpen() {
      const urlParams = new URLSearchParams(window.location.search);
      const queryId = urlParams.get("id");
      const hashId = window.location.hash.startsWith("#news-")
        ? window.location.hash.replace("#news-", "")
        : null;
      const targetId = queryId || hashId;
      if (targetId) {
        const found = newsList.find((n) => String(n.id) === String(targetId));
        if (found) {
          openPreviewModal(found);
        }
      }
    }
    checkAutoOpen();

    // CRUD Helper functions
    async function deleteNews(targetId: string | number) {
      newsList = newsList.filter((n: any) => String(n.id) !== String(targetId));
      localStorage.setItem("dmfk_news", JSON.stringify(newsList));
      renderNewsCards(newsList);

      try {
        const res = await fetch("/api/news", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: targetId }),
        });
        if (res.ok) {
          const resData = await res.json();
          if (resData && Array.isArray(resData.news)) {
            localStorage.setItem("dmfk_news", JSON.stringify(resData.news));
            newsList = resData.news;
            renderNewsCards(newsList);
          }
        }
      } catch (_) {}
    }

    // Global Event Delegation on container for dynamic & pre-rendered news cards
    container.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;

      const editBtn = target.closest(".edit-news-btn") as HTMLElement | null;
      if (editBtn) {
        e.stopPropagation();
        const rawId = editBtn.getAttribute("data-id");
        const news = newsList.find((n) => String(n.id) === String(rawId));
        if (news) openFormModal(news);
        return;
      }

      const deleteBtn = target.closest(
        ".delete-news-btn",
      ) as HTMLElement | null;
      if (deleteBtn) {
        e.stopPropagation();
        const rawId = deleteBtn.getAttribute("data-id");
        const news = newsList.find((n) => String(n.id) === String(rawId));
        if (
          news &&
          confirm(`Apakah Anda yakin ingin menghapus berita "${news.title}"?`)
        ) {
          deleteNews(news.id);
        }
        return;
      }

      const card = target.closest(".news-card") as HTMLElement | null;
      if (card) {
        const rawId = card.getAttribute("data-id");
        const news = newsList.find((n) => String(n.id) === String(rawId));
        if (news) openPreviewModal(news);
      }
    });

    // Form Modal logic (Add/Edit)
    const newsFormModal = document.getElementById(
      "news-form-modal",
    ) as HTMLDialogElement | null;
    const addNewsBtn = document.getElementById("add-news-btn");
    const closeFormBtn = document.getElementById("close-news-form-btn");
    const newsForm = document.getElementById(
      "news-form",
    ) as HTMLFormElement | null;
    const fileInput = document.getElementById(
      "news-form-image-file",
    ) as HTMLInputElement | null;

    function openFormModal(news: NewsItem | null = null) {
      if (!newsFormModal || !newsForm) return;
      updateCategoryDropdown();

      const titleHeader = document.getElementById("form-modal-title");
      const idInput = document.getElementById(
        "news-form-id",
      ) as HTMLInputElement | null;
      const titleInput = document.getElementById(
        "news-form-title",
      ) as HTMLInputElement | null;
      const categoryInput = document.getElementById(
        "news-form-category",
      ) as HTMLSelectElement | null;
      const dateInput = document.getElementById(
        "news-form-date",
      ) as HTMLInputElement | null;
      const tagsInput = document.getElementById(
        "news-form-tags",
      ) as HTMLInputElement | null;
      const imageInput = document.getElementById(
        "news-form-image",
      ) as HTMLInputElement | null;
      const excerptInput = document.getElementById(
        "news-form-excerpt",
      ) as HTMLTextAreaElement | null;
      const contentInput = document.getElementById(
        "news-form-content",
      ) as HTMLTextAreaElement | null;

      if (news) {
        if (titleHeader) titleHeader.textContent = "Edit Berita";
        if (idInput) idInput.value = news.id.toString();
        if (titleInput) titleInput.value = news.title;
        if (categoryInput) categoryInput.value = news.category;
        if (dateInput) dateInput.value = news.date;
        if (tagsInput) tagsInput.value = (news.tags || []).join(", ");
        if (imageInput) imageInput.value = news.image || "";
        if (fileInput) fileInput.value = "";
        if (excerptInput) excerptInput.value = news.excerpt || "";
        if (contentInput) contentInput.value = news.content || "";
      } else {
        if (titleHeader) titleHeader.textContent = "Tambah Berita";
        newsForm.reset();
        if (idInput) idInput.value = "";
        if (imageInput) imageInput.value = "";
        if (fileInput) fileInput.value = "";
        if (excerptInput) excerptInput.value = "";
        if (contentInput) contentInput.value = "";

        if (dateInput) {
          const today = new Date();
          const months = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "Mei",
            "Jun",
            "Jul",
            "Agt",
            "Sep",
            "Okt",
            "Nov",
            "Des",
          ];
          dateInput.value = `${today.getDate()} ${months[today.getMonth()]} ${today.getFullYear()}`;
        }
      }

      newsFormModal.showModal();
    }

    if (addNewsBtn)
      addNewsBtn.addEventListener("click", () => openFormModal(null));
    if (closeFormBtn)
      closeFormBtn.addEventListener("click", () => {
        newsFormModal?.close();
        const idInput = document.getElementById("news-form-id") as HTMLInputElement | null;
        if (idInput) idInput.value = "";
        if (fileInput) fileInput.value = "";
        newsForm?.reset();
      });
    if (newsFormModal) {
      newsFormModal.addEventListener("close", () => {
        const idInput = document.getElementById("news-form-id") as HTMLInputElement | null;
        if (idInput) idInput.value = "";
        if (fileInput) fileInput.value = "";
      });
    }

    // ✅ Auto-convert Google Drive sharing links to direct view URLs
    function convertDriveUrl(
      url: string,
      mode: "view" | "download" = "view",
    ): string {
      if (!url) return "";
      const trimmed = url.trim();
      const fileMatch = trimmed.match(
        /drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/,
      );
      if (fileMatch) {
        return mode === "view"
          ? `https://lh3.googleusercontent.com/d/${fileMatch[1]}`
          : `https://drive.google.com/uc?export=download&id=${fileMatch[1]}`;
      }
      const idMatch = trimmed.match(
        /drive\.google\.com\/(?:open|uc)\?(?:.*&)?id=([a-zA-Z0-9_-]+)/,
      );
      if (idMatch) {
        return mode === "view"
          ? `https://lh3.googleusercontent.com/d/${idMatch[1]}`
          : `https://drive.google.com/uc?export=download&id=${idMatch[1]}`;
      }
      return trimmed;
    }

    // Attach auto-converter to image URL input
    const imageUrlInput = document.getElementById(
      "news-form-image",
    ) as HTMLInputElement | null;
    if (imageUrlInput) {
      imageUrlInput.addEventListener("blur", () => {
        const converted = convertDriveUrl(imageUrlInput.value);
        if (converted !== imageUrlInput.value.trim()) {
          imageUrlInput.value = converted;
          imageUrlInput.style.borderColor = "#16a34a";
          setTimeout(() => (imageUrlInput.style.borderColor = ""), 1500);
        }
      });
    }

    if (newsForm) {
      newsForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const idVal = (
          document.getElementById("news-form-id") as HTMLInputElement
        ).value;
        const titleVal = (
          document.getElementById("news-form-title") as HTMLInputElement
        ).value;
        const categoryVal = (
          document.getElementById("news-form-category") as HTMLSelectElement
        ).value;
        const dateVal = (
          document.getElementById("news-form-date") as HTMLInputElement
        ).value;
        const tagsVal = (
          document.getElementById("news-form-tags") as HTMLInputElement
        ).value;
        const rawImageVal = (
          document.getElementById("news-form-image") as HTMLInputElement
        ).value;
        const imageVal = convertDriveUrl(rawImageVal, "view");
        const excerptVal = (
          document.getElementById("news-form-excerpt") as HTMLTextAreaElement
        ).value;
        const contentVal = (
          document.getElementById("news-form-content") as HTMLTextAreaElement
        ).value;

        const docId = idVal ? parseInt(idVal) : Date.now();
        const tagsArray = tagsVal
          .split(",")
          .map((t) => t.trim())
          .filter((t) => t);

        const defaultPlaceholder =
          "https://images.unsplash.com/photo-1540317580384-e5d43867caa6?auto=format&fit=crop&w=600&q=80";
        let uploadedImageUrl = imageVal || defaultPlaceholder;

        // Upload physical file via /api/upload to avoid multi-MB base64 storage limits
        const file = fileInput?.files?.[0];
        if (file) {
          try {
            const formData = new FormData();
            formData.append("file", file);
            const uploadRes = await fetch("/api/upload", {
              method: "POST",
              body: formData,
            });
            if (uploadRes.ok) {
              const uploadData = await uploadRes.json();
              if (uploadData && uploadData.fileUrl) {
                uploadedImageUrl = uploadData.fileUrl;
              }
            }
          } catch (err) {
            console.warn("Upload to /api/upload failed, falling back to data URL:", err);
            uploadedImageUrl = await new Promise<string>((resolve) => {
              const reader = new FileReader();
              reader.onload = () => resolve(reader.result as string);
              reader.onerror = () => resolve(uploadedImageUrl);
              reader.readAsDataURL(file);
            });
          }
        }

        const entry: NewsItem = {
          id: docId,
          title: titleVal,
          category: categoryVal,
          date: dateVal,
          tags: tagsArray,
          image: uploadedImageUrl,
          excerpt: excerptVal,
          content: contentVal,
        };

        // Upsert into localStorage cache immediately with quota safeguard (optimistic)
        try {
          const cached = JSON.parse(localStorage.getItem("dmfk_news") || "null");
          const base = Array.isArray(cached) ? cached : [...newsList];
          const idx = base.findIndex(
            (n: any) => String(n.id) === String(entry.id),
          );
          if (idx >= 0) base[idx] = entry;
          else base.unshift(entry);
          localStorage.setItem("dmfk_news", JSON.stringify(base));
          newsList = base;
          renderNewsCards(newsList);
        } catch (storageErr) {
          console.warn("localStorage write failed:", storageErr);
        }

        // Sync to server and use server-returned list as source of truth
        try {
          const res = await fetch("/api/news", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(entry),
          });
          if (res.ok) {
            const resData = await res.json();
            if (resData && Array.isArray(resData.news)) {
              try {
                localStorage.setItem("dmfk_news", JSON.stringify(resData.news));
              } catch (_) {}
              newsList = resData.news;
              renderNewsCards(newsList);
            }
          }
        } catch (fetchErr) {
          console.error("Failed to sync news to server:", fetchErr);
        }
        newsFormModal?.close();
        window.location.reload();
      });
    }
  }

  setupProkerInteractions();
  document.addEventListener("astro:after-swap", setupProkerInteractions);
</script>
