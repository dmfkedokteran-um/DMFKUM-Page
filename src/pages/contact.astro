---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Mail, MessageCircle, Instagram, Link2, Edit, X } from 'lucide-astro';
import defaultSettingsData from "../../database/settings.json";

const DEFAULT_CONTACT_SETTINGS = {
  contactEmail: "dmfk.um@um.ac.id",
  contactPhone: "0812-3456-7890",
  contactInstagram: "@dmfk.um",
  contactLinktree: "linktr.ee/dmfk.um",
  contactAddress: "Gedung FK Lt. 2, Universitas Negeri Malang, Jl. Semarang 5, Malang"
};

const siteSettings = Object.assign({}, DEFAULT_CONTACT_SETTINGS, defaultSettingsData);

// Format Phone Number for WhatsApp API Link
const cleanedPhone = (siteSettings.contactPhone || '').replace(/\D/g, '');
const formattedPhone = cleanedPhone.startsWith('0') ? '62' + cleanedPhone.slice(1) : cleanedPhone;
const defaultTemplateMsg = "Halo DMFK UM, selamat [pagi/siang/sore]. Saya [Nama] dari [Fakultas], izin meminta bantuan dan informasi terkait [sebutkan keperluan secara singkat]. Mohon arahannya, terima kasih.";
const waUrl = `https://api.whatsapp.com/send?phone=${formattedPhone}&text=${encodeURIComponent(defaultTemplateMsg)}`;

// Format Instagram Link
const igHandle = (siteSettings.contactInstagram || '').replace('@', '').trim();
const igUrl = siteSettings.contactInstagram.startsWith('http') ? siteSettings.contactInstagram : `https://instagram.com/${igHandle}`;

// Format Linktree Link
const linktreeUrl = siteSettings.contactLinktree.startsWith('http') ? siteSettings.contactLinktree : `https://${siteSettings.contactLinktree}`;
---

<Layout title="Hubungi Kami - DMFK UM" description="Hubungi Kami. Silakan terhubung via Email, WhatsApp, Instagram atau Linktree.">
  <div class="py-16 px-4 max-w-5xl mx-auto animate-fade-in pb-24">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Mari Terhubung</h1>
      <p class="text-gray-500 text-lg font-medium max-w-2xl mx-auto mb-6">
        Pilih salah satu platform di bawah ini untuk terhubung langsung dengan tim kami. Kami siap merespons Anda.
      </p>

      {/* Admin Edit Contact Button */}
      <button 
        id="edit-contact-btn"
        class="admin-only hidden inline-flex items-center gap-2 bg-rose-600 text-white px-6 py-3 rounded-full font-bold hover:bg-rose-700 transition-all shadow-lg shadow-rose-600/20 cursor-pointer outline-none"
      >
        <Edit class="h-5 w-5" /> Edit Informasi Kontak
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {/* Email */}
      <a id="contact-email-link" href={`mailto:${siteSettings.contactEmail}`} class="group bg-white rounded-[2.5rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(225,29,72,0.08)] hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex items-center gap-6">
        <div class="bg-rose-50 text-rose-600 p-5 rounded-3xl group-hover:scale-110 transition-transform">
          <Mail class="h-8 w-8" />
        </div>
        <div>
          <h3 class="font-extrabold text-2xl text-gray-900 mb-1">Email Resmi</h3>
          <p id="contact-email-text" class="text-gray-500 font-medium text-lg group-hover:text-rose-600 transition-colors">{siteSettings.contactEmail}</p>
        </div>
      </a>

      {/* WhatsApp */}
      <a 
        id="contact-wa-link"
        href={waUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="group bg-white rounded-[2.5rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(16,185,129,0.12)] hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex items-center gap-6"
      >
        <div class="bg-emerald-50 text-emerald-600 p-5 rounded-3xl group-hover:scale-110 transition-transform">
          <MessageCircle class="h-8 w-8" />
        </div>
        <div>
          <h3 class="font-extrabold text-2xl text-gray-900 mb-1">WhatsApp</h3>
          <p id="contact-phone-text" class="text-gray-500 font-medium text-lg group-hover:text-emerald-600 transition-colors">{siteSettings.contactPhone}</p>
        </div>
      </a>

      {/* Instagram */}
      <a 
        id="contact-ig-link"
        href={igUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="group bg-white rounded-[2.5rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(217,70,239,0.12)] hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex items-center gap-6"
      >
        <div class="bg-fuchsia-50 text-fuchsia-600 p-5 rounded-3xl group-hover:scale-110 transition-transform">
          <Instagram class="h-8 w-8" />
        </div>
        <div>
          <h3 class="font-extrabold text-2xl text-gray-900 mb-1">Instagram</h3>
          <p id="contact-ig-text" class="text-gray-500 font-medium text-lg group-hover:text-fuchsia-600 transition-colors">{siteSettings.contactInstagram}</p>
        </div>
      </a>

      {/* Linktree */}
      <a 
        id="contact-lt-link"
        href={linktreeUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="group bg-white rounded-[2.5rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_40px_rgb(37,99,235,0.12)] hover:-translate-y-1 transition-all duration-300 border border-gray-50 flex items-center gap-6"
      >
        <div class="bg-blue-50 text-blue-600 p-5 rounded-3xl group-hover:scale-110 transition-transform">
          <Link2 class="h-8 w-8" />
        </div>
        <div>
          <h3 class="font-extrabold text-2xl text-gray-900 mb-1">Linktree</h3>
          <p id="contact-lt-text" class="text-gray-500 font-medium text-lg group-hover:text-blue-600 transition-colors">{siteSettings.contactLinktree}</p>
        </div>
      </a>
    </div>

    <div class="bg-gray-50/50 border border-gray-100 rounded-3xl p-8 text-center text-gray-600 font-medium">
      <p><strong class="text-gray-900">Sekretariat DMFK UM:</strong> <span id="contact-address-text">{siteSettings.contactAddress}</span></p>
    </div>

    {/* Admin Modal Edit Informasi Kontak */}
    <dialog 
      id="contact-modal" 
      closedby="any"
      class="fixed inset-0 bg-transparent p-4 border-none outline-none open:flex justify-center items-center backdrop:bg-gray-900/80 backdrop:backdrop-blur-sm"
    >
      <div class="bg-white w-full max-w-xl rounded-[2.5rem] p-8 shadow-2xl relative border border-gray-100 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-6">
          <div>
            <h2 class="text-2xl font-extrabold text-gray-900">Edit Informasi Kontak</h2>
            <p class="text-sm font-medium text-gray-500 mt-1">Perbarui detail kontak resmi organisasi.</p>
          </div>
          <button id="close-contact-modal-btn" class="p-2 bg-gray-50 hover:bg-gray-100 rounded-full text-gray-400 transition-colors cursor-pointer outline-none">
            <X class="h-5 w-5" />
          </button>
        </div>

        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1">Email Resmi</label>
            <input 
              required 
              type="email" 
              id="email-input"
              value={siteSettings.contactEmail}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1">Nomor WhatsApp</label>
            <input 
              required 
              type="text" 
              id="phone-input"
              value={siteSettings.contactPhone}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1">Instagram Handle</label>
            <input 
              required 
              type="text" 
              id="instagram-input"
              value={siteSettings.contactInstagram}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1">Linktree URL / Handle</label>
            <input 
              required 
              type="text" 
              id="linktree-input"
              value={siteSettings.contactLinktree}
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-1">Alamat Sekretariat</label>
            <textarea 
              required 
              id="address-input"
              rows="2"
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            >{siteSettings.contactAddress}</textarea>
          </div>
          
          <button type="submit" class="w-full mt-4 py-3.5 bg-rose-600 text-white rounded-xl font-bold hover:bg-rose-700 shadow-lg shadow-rose-600/20 hover:shadow-rose-600/40 hover:-translate-y-0.5 transition-all text-base cursor-pointer">
            Simpan Informasi Kontak
          </button>
        </form>
      </div>
    </dialog>

  </div>
</Layout>

<script>
  function setupContactAdmin() {
    const isAdmin = localStorage.getItem('isAdmin') === 'true';

    // ✅ Apply localStorage contact info overrides on page load
    const cachedSettings = localStorage.getItem('dmfk_settings');
    if (cachedSettings) {
      try {
        const s = JSON.parse(cachedSettings);
        if (s.contactEmail) {
          const el = document.getElementById('contact-email-text');
          const link = document.getElementById('contact-email-link') as HTMLAnchorElement | null;
          if (el) el.textContent = s.contactEmail;
          if (link) link.href = `mailto:${s.contactEmail}`;
        }
        if (s.contactPhone) {
          const el = document.getElementById('contact-phone-text');
          const link = document.getElementById('contact-wa-link') as HTMLAnchorElement | null;
          if (el) el.textContent = s.contactPhone;
          if (link) {
            const cleaned = s.contactPhone.replace(/\D/g, '');
            const formatted = cleaned.startsWith('0') ? '62' + cleaned.slice(1) : cleaned;
            const msg = encodeURIComponent('Halo DMFK UM, selamat [pagi/siang/sore]. Saya [Nama] dari [Fakultas], izin meminta bantuan dan informasi terkait [sebutkan keperluan secara singkat]. Mohon arahannya, terima kasih.');
            link.href = `https://api.whatsapp.com/send?phone=${formatted}&text=${msg}`;
          }
        }
        if (s.contactInstagram) {
          const el = document.getElementById('contact-ig-text');
          const link = document.getElementById('contact-ig-link') as HTMLAnchorElement | null;
          if (el) el.textContent = s.contactInstagram;
          if (link) {
            const handle = s.contactInstagram.replace('@', '').trim();
            link.href = s.contactInstagram.startsWith('http') ? s.contactInstagram : `https://instagram.com/${handle}`;
          }
        }
        if (s.contactLinktree) {
          const el = document.getElementById('contact-lt-text');
          const link = document.getElementById('contact-lt-link') as HTMLAnchorElement | null;
          if (el) el.textContent = s.contactLinktree;
          if (link) link.href = s.contactLinktree.startsWith('http') ? s.contactLinktree : `https://${s.contactLinktree}`;
        }
        if (s.contactAddress) {
          const el = document.getElementById('contact-address-text');
          if (el) el.textContent = s.contactAddress;
        }
      } catch (e) {}
    }

    // 🌐 Fetch latest settings from server to sync contact info across devices
    fetch('/api/settings')
      .then(res => res.ok ? res.json() : null)
      .then(resData => {
        if (resData && resData.isCloud && resData.settings && typeof resData.settings === 'object') {
          const serverSettings = resData.settings;
          const current = JSON.parse(localStorage.getItem('dmfk_settings') || '{}');
          const merged = { ...current, ...serverSettings };
          const currentStr = localStorage.getItem('dmfk_settings');
          const mergedStr = JSON.stringify(merged);
          if (mergedStr !== currentStr) {
            localStorage.setItem('dmfk_settings', mergedStr);
            if (merged.contactEmail) {
              const el = document.getElementById('contact-email-text');
              if (el) { el.textContent = merged.contactEmail; (el as HTMLAnchorElement).href = `mailto:${merged.contactEmail}`; }
            }
            if (merged.contactPhone) {
              const el = document.getElementById('contact-phone-text');
              if (el) { el.textContent = merged.contactPhone; (el as HTMLAnchorElement).href = `https://wa.me/${merged.contactPhone.replace(/[^0-9]/g, '')}`; }
            }
            if (merged.contactInstagram) {
              const el = document.getElementById('contact-instagram-text');
              if (el) { el.textContent = merged.contactInstagram; (el as HTMLAnchorElement).href = `https://instagram.com/${merged.contactInstagram.replace('@', '')}`; }
            }
            if (merged.contactLinktree) {
              const el = document.getElementById('contact-linktree-text');
              if (el) { el.textContent = merged.contactLinktree; (el as HTMLAnchorElement).href = merged.contactLinktree.startsWith('http') ? merged.contactLinktree : `https://${merged.contactLinktree}`; }
            }
            if (merged.contactAddress) {
              const el = document.getElementById('contact-address-text');
              if (el) el.textContent = merged.contactAddress;
            }
          }
        }
      })
      .catch(() => {});

    // Show/Hide Admin Controls
    const adminControls = document.querySelectorAll('.admin-only');
    adminControls.forEach(el => {
      if (isAdmin) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    const editContactBtn = document.getElementById('edit-contact-btn');
    const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;
    const closeContactModalBtn = document.getElementById('close-contact-modal-btn');
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;

    if (editContactBtn && contactModal) {
      editContactBtn.addEventListener('click', () => {
        try {
          const s = JSON.parse(localStorage.getItem('dmfk_settings') || '{}');
          if (s.contactEmail) (document.getElementById('email-input') as HTMLInputElement).value = s.contactEmail;
          if (s.contactPhone) (document.getElementById('phone-input') as HTMLInputElement).value = s.contactPhone;
          if (s.contactInstagram) (document.getElementById('instagram-input') as HTMLInputElement).value = s.contactInstagram;
          if (s.contactLinktree) (document.getElementById('linktree-input') as HTMLInputElement).value = s.contactLinktree;
          if (s.contactAddress) (document.getElementById('address-input') as HTMLTextAreaElement).value = s.contactAddress;
        } catch (e) {}
        contactModal.showModal();
      });
    }

    if (closeContactModalBtn && contactModal) {
      closeContactModalBtn.addEventListener('click', () => {
        contactModal.close();
      });
    }

    if (contactForm && contactModal) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const emailVal = (document.getElementById('email-input') as HTMLInputElement).value.trim();
        const phoneVal = (document.getElementById('phone-input') as HTMLInputElement).value.trim();
        const instagramVal = (document.getElementById('instagram-input') as HTMLInputElement).value.trim();
        const linktreeVal = (document.getElementById('linktree-input') as HTMLInputElement).value.trim();
        const addressVal = (document.getElementById('address-input') as HTMLTextAreaElement).value.trim();

        const contactPayload = {
          contactEmail: emailVal,
          contactPhone: phoneVal,
          contactInstagram: instagramVal,
          contactLinktree: linktreeVal,
          contactAddress: addressVal
        };
        // Try server save, always persist to localStorage as fallback
        try {
          await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(contactPayload)
          }).catch(() => {});
        } catch (_) {}
        const cachedContact = JSON.parse(localStorage.getItem('dmfk_settings') || '{}');
        Object.assign(cachedContact, contactPayload);
        localStorage.setItem('dmfk_settings', JSON.stringify(cachedContact));
        contactModal.close();
        window.location.reload();
      });
    }
  }

  setupContactAdmin();
  document.addEventListener('astro:after-swap', setupContactAdmin);
  document.addEventListener('astro:page-load', setupContactAdmin);
</script>
