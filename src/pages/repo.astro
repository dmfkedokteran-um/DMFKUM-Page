---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Search, Filter, FileText, Eye, Download, File, X, Plus, Edit, Trash2 } from 'lucide-astro';
import { MOCK_DOCS } from '../data/mockData.js';
import defaultDocsData from "../../database/docs.json";

const categories = ["Semua", "Regulasi", "Laporan", "Panduan", "Materi Publik"];
const docs = defaultDocsData && Array.isArray(defaultDocsData) ? defaultDocsData : [];
---

<Layout title="Repositori Berkas - DMFK UM" description="Pusat pangkalan data publik resmi DMFK UM. Temukan, pratinjau, dan unduh dokumen resmi organisasi secara instan.">
  <div class="py-16 px-4 max-w-7xl mx-auto animate-fade-in pb-24">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
      <div class="text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Repositori Berkas</h1>
        <p class="text-gray-500 max-w-3xl text-lg font-medium leading-relaxed">
          Pusat pangkalan data publik yang terstruktur. Temukan, pratinjau, dan unduh dokumen resmi organisasi kami dengan cepat.
        </p>
      </div>
      <button 
        id="add-doc-btn"
        class="admin-only hidden flex items-center gap-2 bg-rose-600 text-white px-6 py-3 rounded-full font-bold hover:bg-rose-700 transition-colors shadow-lg shadow-rose-600/20 shrink-0 cursor-pointer outline-none"
      >
        <Plus class="h-5 w-5" /> Tambah Dokumen
      </button>
    </div>

    {/* Glassy Filter Bar */}
    <div class="bg-white/80 backdrop-blur-md p-4 rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100 flex flex-col md:flex-row gap-4 mb-10">
      <div class="relative flex-1">
        <Search class="absolute left-5 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" />
        <input 
          type="text" 
          id="search-input"
          placeholder="Ketik judul dokumen..."
          class="w-full pl-14 pr-6 py-4 bg-gray-50/50 hover:bg-gray-50 border border-transparent rounded-[1.5rem] focus:bg-white focus:border-rose-300 focus:ring-4 focus:ring-rose-100 outline-none transition-all font-medium text-gray-700"
        />
      </div>
      <div class="flex items-center gap-2 min-w-[200px]">
        <div class="relative w-full">
          <Filter class="absolute left-5 top-1/2 -translate-y-1/2 h-5 w-5 text-gray-400" />
          <select 
            id="category-filter"
            class="w-full pl-12 pr-10 py-4 bg-gray-50/50 hover:bg-gray-50 border border-transparent rounded-[1.5rem] focus:bg-white focus:border-rose-300 focus:ring-4 focus:ring-rose-100 outline-none transition-all font-medium text-gray-700 appearance-none cursor-pointer"
          >
            {categories.map(cat => <option value={cat}>{cat}</option>)}
          </select>
        </div>
      </div>
    </div>

    {/* Document List */}
    <div class="bg-transparent rounded-3xl overflow-hidden">
      {/* Empty State */}
      <div id="empty-state" class="p-16 text-center bg-white rounded-[2rem] border border-gray-100 shadow-sm hidden">
        <FileText class="h-12 w-12 text-gray-300 mx-auto mb-4" />
        <p class="text-gray-500 font-medium text-lg">Tidak ada dokumen yang relevan ditemukan.</p>
      </div>

      {/* Documents items wrapper */}
      <div id="doc-list" class="space-y-4" data-initial={JSON.stringify(docs)}>
        {docs.map(doc => (
          <div 
            class="doc-item bg-white p-5 md:p-6 rounded-[2rem] shadow-sm hover:shadow-[0_8px_30px_rgb(0,0,0,0.05)] border border-gray-100 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-6 group"
            data-title={doc.title}
            data-category={doc.category}
            data-id={doc.id}
          >
            <div class="flex items-start gap-5">
              <div class={`p-4 rounded-2xl shrink-0 transition-transform group-hover:scale-110 ${doc.ext === 'PDF' ? 'bg-rose-50 text-rose-600' : doc.ext === 'DOCX' ? 'bg-blue-50 text-blue-600' : 'bg-amber-50 text-amber-600'}`}>
                <FileText class="h-8 w-8" />
              </div>
              <div>
                <h3 class="font-extrabold text-gray-900 text-lg group-hover:text-rose-700 transition-colors">{doc.title}</h3>
                <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mt-2 font-medium">
                  <span class="bg-gray-100/80 px-3 py-1 rounded-full text-xs text-gray-600">{doc.category}</span>
                  <span>{doc.date}</span>
                  <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                  <span>{doc.size}</span>
                </div>
              </div>
            </div>
            
            <div class="flex gap-3 sm:ml-auto w-full sm:w-auto items-center">
              {/* Admin actions */}
              <div class="admin-only hidden flex gap-2">
                <button 
                  class="edit-doc-btn p-2.5 bg-gray-50 text-blue-600 rounded-full hover:bg-blue-50 transition-colors cursor-pointer outline-none"
                  data-id={doc.id}
                >
                  <Edit class="h-4 w-4"/>
                </button>
                <button 
                  class="delete-doc-btn p-2.5 bg-gray-50 text-rose-600 rounded-full hover:bg-rose-50 transition-colors cursor-pointer outline-none"
                  data-id={doc.id}
                >
                  <Trash2 class="h-4 w-4"/>
                </button>
              </div>

              <button 
                class="open-doc-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 bg-gray-50 text-gray-700 rounded-full hover:bg-gray-100 transition-colors text-sm font-bold outline-none cursor-pointer"
                data-target={`doc-modal-${doc.id}`}
              >
                <Eye class="h-4 w-4" /> Buka
              </button>
              <button 
                class="download-btn flex-1 sm:flex-none flex items-center justify-center gap-2 px-5 py-2.5 bg-rose-600 text-white rounded-full hover:bg-rose-700 transition-all shadow-lg shadow-rose-600/20 hover:shadow-rose-600/40 hover:-translate-y-0.5 text-sm font-bold outline-none cursor-pointer"
                data-id={doc.id}
                data-title={doc.title}
              >
                <Download class="h-4 w-4" /> Unduh
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* --- CLEAN DOCUMENT PREVIEW MODAL --- */}
    <dialog 
      id="doc-preview-modal" 
      closedby="any"
      class="fixed inset-0 bg-transparent p-2 sm:p-6 border-none outline-none open:flex justify-center items-center backdrop:bg-gray-900/80 backdrop:backdrop-blur-sm"
    >
      <div class="modal-content bg-white w-full max-w-5xl h-[92vh] rounded-[2rem] flex flex-col shadow-2xl overflow-hidden relative border border-gray-100">
        
        {/* Modal Header */}
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-white z-10 shrink-0">
          <div class="flex items-center gap-3.5">
            <div id="preview-doc-icon-container" class="p-2.5 rounded-xl bg-rose-50 text-rose-600">
               <File class="h-5 w-5" />
            </div>
            <div class="text-left">
              <h3 id="preview-doc-title" class="font-extrabold text-base sm:text-lg text-gray-900 line-clamp-1"></h3>
              <p id="preview-doc-meta" class="text-xs font-semibold text-gray-400 mt-0.5 tracking-wider uppercase"></p>
            </div>
          </div>
          <button id="close-doc-preview-btn" class="p-2.5 hover:bg-gray-100 rounded-full text-gray-500 transition-colors outline-none cursor-pointer">
            <X class="h-5 w-5" />
          </button>
        </div>

        {/* Clean Viewer Area */}
        <div id="preview-doc-container" class="flex-1 bg-gray-50 flex flex-col overflow-hidden relative p-0">
          <div id="preview-doc-content" class="w-full h-full flex-1 overflow-y-auto">
            {/* Dynamic Content */}
          </div>
        </div>

        {/* Modal Footer */}
        <div class="px-6 py-3.5 border-t border-gray-100 bg-white flex justify-between items-center z-10 shrink-0">
          <div id="preview-doc-footer-info" class="text-xs font-bold text-gray-400">Dokumen Resmi DMFK UM</div>
          <button 
            id="modal-download-btn-shared"
            title="Unduh Dokumen"
            class="modal-download-btn bg-rose-600 hover:bg-rose-700 text-white p-3 rounded-full font-bold flex items-center justify-center shadow-md shadow-rose-600/20 hover:scale-110 transition-all outline-none cursor-pointer"
          >
            <Download class="h-5 w-5" />
          </button>
        </div>
      </div>
    </dialog>

    {/* Modal Form Tambah/Edit Dokumen */}
    <dialog 
      id="doc-form-modal" 
      closedby="any"
      class="fixed inset-0 bg-transparent p-4 border-none outline-none open:flex justify-center items-center backdrop:bg-gray-900/80 backdrop:backdrop-blur-sm"
    >
      <div class="bg-white w-full max-w-xl rounded-[2.5rem] p-8 shadow-2xl relative border border-gray-100 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 id="doc-form-modal-title" class="text-2xl font-extrabold text-gray-900">Tambah Dokumen</h2>
            <p class="text-sm font-medium text-gray-500 mt-1">Lengkapi data dokumen di bawah ini.</p>
          </div>
          <button id="close-doc-form-btn" class="p-2 bg-gray-50 hover:bg-gray-100 rounded-full text-gray-400 transition-colors cursor-pointer outline-none">
            <X class="h-5 w-5" />
          </button>
        </div>

        <form id="doc-form" class="space-y-5">
          <input type="hidden" id="doc-form-id" />
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Judul Dokumen</label>
            <input 
              required 
              type="text" 
              id="doc-form-title"
              placeholder="Masukkan judul dokumen" 
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Kategori</label>
              <select 
                id="doc-form-category"
                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 cursor-pointer"
              >
                <option value="Regulasi">Regulasi</option>
                <option value="Laporan">Laporan</option>
                <option value="Panduan">Panduan</option>
                <option value="Materi Publik">Materi Publik</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Ekstensi File</label>
              <select 
                id="doc-form-ext"
                class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 cursor-pointer"
              >
                <option value="PDF">PDF</option>
                <option value="DOCX">DOCX</option>
                <option value="XLSX">XLSX</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Tanggal Terbit</label>
            <input 
              required 
              type="text" 
              id="doc-form-date"
              placeholder="Contoh: 15 Jan 2026" 
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Upload Berkas Fisik (PDF, Gambar, dll)</label>
            <input 
              type="file" 
              id="doc-form-file" 
              accept=".pdf,.png,.jpg,.jpeg,.docx,.xlsx" 
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 cursor-pointer"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Atau Link Google Drive / External URL</label>
            <input 
              type="url" 
              id="doc-form-url" 
              placeholder="Paste link Google Drive (contoh: https://drive.google.com/file/d/...)" 
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            />
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Isi Konten Dokumen (Paragraf)</label>
            <textarea 
              required 
              id="doc-form-content"
              rows="4"
              placeholder="Tuliskan isi simulasi dokumen..." 
              class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-rose-200 focus:border-rose-300 outline-none transition-all font-medium text-gray-800"
            ></textarea>
          </div>
          
          <button type="submit" class="w-full mt-6 py-4 bg-rose-600 text-white rounded-xl font-bold hover:bg-rose-700 shadow-lg shadow-rose-600/20 hover:shadow-rose-600/40 hover:-translate-y-0.5 transition-all text-lg cursor-pointer">
            Simpan Dokumen
          </button>
        </form>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  interface DocItem {
    id: number;
    title: string;
    category: string;
    ext: string;
    size: string;
    date: string;
    downloads: number;
    content?: string;
    fileUrl?: string;
  }

  // --- IndexedDB Configuration & Helpers (Fallback) ---
  const dbName = 'DMFKUMRepoDB';
  const storeName = 'documents';

  function openDB(): Promise<any> {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(dbName, 1);
      request.onupgradeneeded = () => {
        const db = request.result;
        if (!db.objectStoreNames.contains(storeName)) {
          db.createObjectStore(storeName, { keyPath: 'id' });
        }
      };
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  async function getFileFromDB(id: number): Promise<any> {
    try {
      const db: any = await openDB();
      return new Promise((resolve, reject) => {
        const transaction = db.transaction(storeName, 'readonly');
        const store = transaction.objectStore(storeName);
        const request = store.get(id);
        request.onsuccess = () => resolve(request.result ? request.result.fileBlob : null);
        request.onerror = () => reject(request.error);
      });
    } catch (e) {
      console.error("Failed to fetch from IndexedDB", e);
      return null;
    }
  }

  function formatBytes(bytes, decimals = 1) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
  }

  let currentObjectURL = '';

  function setupRepoInteractions() {
    const container = document.getElementById('doc-list');
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const emptyState = document.getElementById('empty-state');
    const isAdmin = localStorage.getItem('isAdmin') === 'true';

    const adminControls = document.querySelectorAll('.admin-only');
    adminControls.forEach(el => {
      if (isAdmin) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    if (!container) return;

    const initialData = container.getAttribute('data-initial') || '[]';
    let docsList = JSON.parse(initialData);

    function renderDocsCards(items) {
      if (!container) return;
      const getExtColor = (ext) => ext === 'PDF' ? 'bg-rose-50 text-rose-600' : ext === 'DOCX' ? 'bg-blue-50 text-blue-600' : 'bg-amber-50 text-amber-600';
      container.innerHTML = items.map(doc => `
        <div class="doc-item bg-white p-5 md:p-6 rounded-[2rem] shadow-sm hover:shadow-[0_8px_30px_rgb(0,0,0,0.05)] border border-gray-100 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-6 group"
          data-title="${doc.title}"
          data-category="${doc.category}"
          data-id="${doc.id}">
          <div class="flex items-start gap-5">
            <div class="p-4 rounded-2xl shrink-0 transition-transform group-hover:scale-110 ${getExtColor(doc.ext)}">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div>
              <h3 class="font-extrabold text-gray-900 text-lg group-hover:text-rose-700 transition-colors">${doc.title}</h3>
              <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mt-2 font-medium">
                <span class="bg-gray-100/80 px-3 py-1 rounded-full text-xs text-gray-600">${doc.category}</span>
                <span>${doc.date}</span>
                <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                <span>${doc.size}</span>
              </div>
            </div>
          </div>
          <div class="flex gap-3 sm:ml-auto w-full sm:w-auto items-center">
            <div class="admin-only ${isAdmin ? '' : 'hidden'} flex gap-2">
              <button class="edit-doc-btn p-2.5 bg-gray-50 text-blue-600 rounded-full hover:bg-blue-50 transition-colors cursor-pointer outline-none" data-id="${doc.id}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
              </button>
              <button class="delete-doc-btn p-2.5 bg-gray-50 text-rose-600 rounded-full hover:bg-rose-50 transition-colors cursor-pointer outline-none" data-id="${doc.id}">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
              </button>
            </div>
            <button class="open-doc-btn flex-1 sm:flex-none px-5 py-3 bg-gray-50 hover:bg-rose-50 text-gray-700 hover:text-rose-700 rounded-full font-bold text-sm transition-all flex items-center gap-2 cursor-pointer outline-none" data-id="${doc.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Buka
            </button>
            <button class="download-btn flex-1 sm:flex-none px-5 py-3 bg-rose-600 hover:bg-rose-700 text-white rounded-full font-bold text-sm transition-all flex items-center gap-2 shadow-sm shadow-rose-600/20 cursor-pointer outline-none" data-id="${doc.id}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span id="downloads-count-${doc.id}">${doc.downloads} Unduhan</span>
            </button>
          </div>
        </div>
      `).join('');
    }

    // ✅ Apply any admin edits stored in localStorage
    const cachedDocs = localStorage.getItem('dmfk_docs');
    if (cachedDocs) {
      try {
        docsList = JSON.parse(cachedDocs);
        renderDocsCards(docsList);
      } catch (e) {
        console.error('Failed to parse cached docs:', e);
      }
    }

    // 🌐 Fetch latest from cloud server database to sync across all devices
    fetch('/api/docs')
      .then(res => res.ok ? res.json() : null)
      .then(resData => {
        if (resData && Array.isArray(resData.docs) && resData.docs.length > 0) {
          localStorage.setItem('dmfk_docs', JSON.stringify(resData.docs));
          docsList = resData.docs;
          renderDocsCards(docsList);
        }
      })
      .catch(() => {});

    function filterDocs() {
      const searchInputEl = document.getElementById('search-input') as HTMLInputElement | null;
      const categoryFilterEl = document.getElementById('category-filter') as HTMLSelectElement | null;

      const searchVal = searchInputEl?.value.toLowerCase().trim() || '';
      const catVal = categoryFilterEl?.value || 'Semua';
      let visibleCount = 0;

      const items = container?.querySelectorAll('.doc-item');
      items?.forEach(item => {
        const title = item.getAttribute('data-title')?.toLowerCase() || '';
        const cat = item.getAttribute('data-category') || '';

        const titleMatch = !searchVal || title.includes(searchVal);
        const catMatch = catVal === 'Semua' || cat === catVal;

        if (titleMatch && catMatch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.removeEventListener('input', filterDocs);
      searchInput.addEventListener('input', filterDocs);
    }
    if (categoryFilter) {
      categoryFilter.removeEventListener('change', filterDocs);
      categoryFilter.addEventListener('change', filterDocs);
    }

    const handleDownload = async (doc: DocItem) => {
      doc.downloads = (doc.downloads || 0) + 1;
      const countSpan = document.getElementById(`downloads-count-${doc.id}`);
      if (countSpan) {
        countSpan.textContent = `${doc.downloads} Unduhan`;
      }

      fetch('/api/docs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(doc)
      }).catch(() => {});

      const sanitizeName = (doc.title || 'dokumen').replace(/[^a-zA-Z0-9_\- ]/g, '_');
      const extStr = (doc.ext || 'pdf').toLowerCase();
      const fileName = `${sanitizeName}.${extStr}`;

      if (doc.fileUrl) {
        if (doc.fileUrl.startsWith('http://') || doc.fileUrl.startsWith('https://')) {
          window.open(doc.fileUrl, '_blank');
        } else if (doc.fileUrl.startsWith('data:')) {
          try {
            const parts = doc.fileUrl.split(';base64,');
            const contentType = parts[0].split(':')[1] || 'application/pdf';
            const raw = window.atob(parts[1]);
            const uInt8Array = new Uint8Array(raw.length);
            for (let i = 0; i < raw.length; ++i) uInt8Array[i] = raw.charCodeAt(i);
            const blob = new Blob([uInt8Array], { type: contentType });
            const blobUrl = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(blobUrl), 10000);
          } catch (e) {
            window.open(doc.fileUrl, '_blank');
          }
        } else {
          const a = document.createElement('a');
          a.href = doc.fileUrl;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        }
      } else {
        const fileBlob = await getFileFromDB(doc.id);
        if (fileBlob) {
          const url = URL.createObjectURL(fileBlob as Blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        } else {
          const blob = new Blob([doc.content || "Dokumen Resmi DMFK UM."], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${sanitizeName}.txt`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 10000);
        }
      }
    };

    async function deleteDoc(id: number) {
      // Remove from localStorage immediately
      const cached = JSON.parse(localStorage.getItem('dmfk_docs') || 'null');
      if (cached) {
        const updated = cached.filter((d: any) => String(d.id) !== String(id));
        localStorage.setItem('dmfk_docs', JSON.stringify(updated));
      }
      // Try server delete — send id in JSON body
      try {
        const res = await fetch('/api/docs', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        if (res.ok) {
          const resData = await res.json();
          if (resData && Array.isArray(resData.docs)) {
            localStorage.setItem('dmfk_docs', JSON.stringify(resData.docs));
          }
        }
      } catch (_) {}
      window.location.reload();
    }

    function getDriveFileId(url: string): string | null {
      if (!url) return null;
      const fileMatch = url.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (fileMatch) return fileMatch[1];
      const idMatch = url.match(/drive\.google\.com\/(?:open|uc)\?(?:.*&)?id=([a-zA-Z0-9_-]+)/);
      if (idMatch) return idMatch[1];
      const lh3Match = url.match(/lh3\.googleusercontent\.com\/d\/([a-zA-Z0-9_-]+)/);
      if (lh3Match) return lh3Match[1];
      return null;
    }

    const previewModal = document.getElementById('doc-preview-modal') as HTMLDialogElement | null;
    const closePreviewBtn = document.getElementById('close-doc-preview-btn');

    async function openPreviewModal(doc: DocItem) {
      if (!previewModal) return;

      const titleEl = document.getElementById('preview-doc-title');
      const metaEl = document.getElementById('preview-doc-meta');
      const contentEl = document.getElementById('preview-doc-content');
      const iconContainer = document.getElementById('preview-doc-icon-container');
      const footerInfo = document.getElementById('preview-doc-footer-info');
      
      if (titleEl) titleEl.textContent = doc.title;
      if (metaEl) metaEl.textContent = `${doc.ext} • ${doc.size}`;
      if (footerInfo) footerInfo.textContent = `Diterbitkan: ${doc.date} • ${doc.category}`;
      if (iconContainer) iconContainer.className = `p-2.5 rounded-xl ${doc.ext === 'PDF' ? 'bg-rose-50 text-rose-600' : doc.ext === 'DOCX' ? 'bg-blue-50 text-blue-600' : 'bg-amber-50 text-amber-600'}`;

      if (currentObjectURL) { URL.revokeObjectURL(currentObjectURL); currentObjectURL = ''; }

      if (contentEl) {
        contentEl.innerHTML = '';

        const driveId = doc.fileUrl ? getDriveFileId(doc.fileUrl) : null;

        if (driveId) {
          // Google Drive preview URL allows iframe embedding for PDF, DOCX, XLSX, images, etc.
          contentEl.innerHTML = `<iframe src="https://drive.google.com/file/d/${driveId}/preview" class="w-full h-full min-h-[550px] border-none bg-white rounded-xl" allow="autoplay"></iframe>`;
        } else if (doc.fileUrl) {
          if (doc.fileUrl.startsWith('data:application/pdf') || doc.ext === 'PDF' || doc.fileUrl.toLowerCase().endsWith('.pdf')) {
            contentEl.innerHTML = `<iframe src="${doc.fileUrl}" class="w-full h-full min-h-[550px] border-none bg-white rounded-xl"></iframe>`;
          } else if (doc.fileUrl.startsWith('data:image') || ['PNG', 'JPG', 'JPEG', 'WEBP'].includes(doc.ext.toUpperCase()) || /\.(png|jpg|jpeg|webp)$/i.test(doc.fileUrl)) {
            contentEl.innerHTML = `<div class="w-full h-full flex justify-center items-center p-6 bg-gray-900/5"><img src="${doc.fileUrl}" class="max-w-full max-h-full rounded-2xl shadow-md object-contain" /></div>`;
          } else if (doc.fileUrl.startsWith('http://') || doc.fileUrl.startsWith('https://')) {
            contentEl.innerHTML = `<iframe src="https://docs.google.com/viewer?url=${encodeURIComponent(doc.fileUrl)}&embedded=true" class="w-full h-full min-h-[550px] border-none bg-white rounded-xl"></iframe>`;
          } else if (doc.content) {
            const paragraphs = doc.content.split('\n').filter(p => p.trim()).map(p => '<p class="mb-4 text-gray-700 leading-relaxed font-medium">' + p + '</p>').join('');
            contentEl.innerHTML = `
              <div class="p-6 sm:p-12 max-w-3xl mx-auto my-6 bg-white rounded-2xl shadow-sm border border-gray-100/80">
                <div class="border-b border-gray-100 pb-6 mb-6">
                  <h2 class="text-2xl font-extrabold text-gray-900 leading-tight">${doc.title}</h2>
                  <p class="text-xs text-gray-400 font-medium mt-2">Diterbitkan: ${doc.date}</p>
                </div>
                <div class="text-gray-700 text-base leading-relaxed">
                  ${paragraphs}
                </div>
              </div>
            `;
          }
        } else {
          const fileBlob = await getFileFromDB(doc.id);
          if (fileBlob) {
            currentObjectURL = URL.createObjectURL(fileBlob as Blob);
            if (doc.ext === 'PDF') {
              contentEl.innerHTML = `<iframe src="${currentObjectURL}" class="w-full h-full min-h-[550px] border-none bg-white rounded-xl"></iframe>`;
            } else if (['PNG', 'JPG', 'JPEG', 'WEBP'].includes(doc.ext.toUpperCase())) {
              contentEl.innerHTML = `<div class="w-full h-full flex justify-center items-center p-6 bg-gray-900/5"><img src="${currentObjectURL}" class="max-w-full max-h-full rounded-2xl shadow-md object-contain" /></div>`;
            } else {
              contentEl.innerHTML = `<iframe src="https://docs.google.com/viewer?url=${encodeURIComponent(currentObjectURL)}&embedded=true" class="w-full h-full min-h-[550px] border-none bg-white rounded-xl"></iframe>`;
            }
          } else if (doc.content) {
            const paragraphs = doc.content.split('\n').filter(p => p.trim()).map(p => '<p class="mb-4 text-gray-700 leading-relaxed font-medium">' + p + '</p>').join('');
            contentEl.innerHTML = `
              <div class="p-6 sm:p-12 max-w-3xl mx-auto my-6 bg-white rounded-2xl shadow-sm border border-gray-100/80">
                <div class="border-b border-gray-100 pb-6 mb-6">
                  <h2 class="text-2xl font-extrabold text-gray-900 leading-tight">${doc.title}</h2>
                  <p class="text-xs text-gray-400 font-medium mt-2">Diterbitkan: ${doc.date}</p>
                </div>
                <div class="text-gray-700 text-base leading-relaxed">
                  ${paragraphs}
                </div>
              </div>
            `;
          }
        }
      }

      const modalDLBtn = document.getElementById('modal-download-btn-shared');
      if (modalDLBtn) {
        const newDLBtn = modalDLBtn.cloneNode(true) as HTMLButtonElement;
        modalDLBtn.parentNode?.replaceChild(newDLBtn, modalDLBtn);
        newDLBtn.addEventListener('click', () => { 
          handleDownload(doc); 
          previewModal.close(); 
          document.body.classList.remove('overflow-hidden'); 
          if (currentObjectURL) { URL.revokeObjectURL(currentObjectURL); currentObjectURL = ''; } 
        });
      }

      previewModal.showModal();
      document.body.classList.add('overflow-hidden');
    }

    if (previewModal && closePreviewBtn) {
      const closeHandler = () => { 
        previewModal.close(); 
        document.body.classList.remove('overflow-hidden'); 
        if (currentObjectURL) { URL.revokeObjectURL(currentObjectURL); currentObjectURL = ''; } 
      };
      closePreviewBtn.addEventListener('click', closeHandler);
      previewModal.addEventListener('click', (e) => { if (e.target === previewModal) closeHandler(); });
    }

    // Global Event Delegation on container for dynamic & pre-rendered document items
    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const editBtn = target.closest('.edit-doc-btn') as HTMLElement | null;
      if (editBtn) {
        e.stopPropagation();
        const id = parseInt(editBtn.getAttribute('data-id') || '0');
        const doc = docsList.find(d => d.id === id);
        if (doc) openFormModal(doc);
        return;
      }

      const deleteBtn = target.closest('.delete-doc-btn') as HTMLElement | null;
      if (deleteBtn) {
        e.stopPropagation();
        const id = parseInt(deleteBtn.getAttribute('data-id') || '0');
        const doc = docsList.find(d => d.id === id);
        if (doc && confirm(`Apakah Anda yakin ingin menghapus dokumen "${doc.title}"?`)) deleteDoc(doc.id);
        return;
      }

      const dlBtn = target.closest('.download-btn') as HTMLElement | null;
      if (dlBtn) {
        e.stopPropagation();
        const id = parseInt(dlBtn.getAttribute('data-id') || '0');
        const doc = docsList.find(d => d.id === id);
        if (doc) handleDownload(doc);
        return;
      }

      const row = target.closest('.doc-item') as HTMLElement | null;
      if (row) {
        const id = parseInt(row.getAttribute('data-id') || '0');
        const doc = docsList.find(d => d.id === id);
        if (doc) openPreviewModal(doc);
      }
    });

    const docFormModal = document.getElementById('doc-form-modal') as HTMLDialogElement | null;
    const addDocBtn = document.getElementById('add-doc-btn');
    const closeFormBtn = document.getElementById('close-doc-form-btn');
    const docForm = document.getElementById('doc-form') as HTMLFormElement | null;
    const fileInput = document.getElementById('doc-form-file') as HTMLInputElement | null;

    if (fileInput) {
      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) {
          const nameParts = file.name.split('.');
          const rawExt = nameParts[nameParts.length - 1].toUpperCase();
          const extSelect = document.getElementById('doc-form-ext') as HTMLSelectElement | null;
          if (extSelect) {
            if (![...extSelect.options].some(o => o.value === rawExt)) {
              const opt = document.createElement('option');
              opt.value = rawExt; opt.textContent = rawExt; extSelect.appendChild(opt);
            }
            extSelect.value = rawExt;
          }
          const titleInput = document.getElementById('doc-form-title') as HTMLInputElement | null;
          if (titleInput && !titleInput.value) titleInput.value = nameParts.slice(0, -1).join('.');
        }
      });
    }

    function convertDriveUrl(url: string, mode: 'view' | 'download' = 'download'): string {
      if (!url) return '';
      const trimmed = url.trim();
      const fileMatch = trimmed.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
      if (fileMatch) {
        return mode === 'view' 
          ? `https://lh3.googleusercontent.com/d/${fileMatch[1]}` 
          : `https://drive.google.com/uc?export=download&id=${fileMatch[1]}`;
      }
      const idMatch = trimmed.match(/drive\.google\.com\/(?:open|uc)\?(?:.*&)?id=([a-zA-Z0-9_-]+)/);
      if (idMatch) {
        return mode === 'view' 
          ? `https://lh3.googleusercontent.com/d/${idMatch[1]}` 
          : `https://drive.google.com/uc?export=download&id=${idMatch[1]}`;
      }
      return trimmed;
    }

    const docUrlInput = document.getElementById('doc-form-url') as HTMLInputElement | null;
    if (docUrlInput) {
      docUrlInput.addEventListener('blur', () => {
        const converted = convertDriveUrl(docUrlInput.value, 'download');
        if (converted !== docUrlInput.value.trim()) {
          docUrlInput.value = converted;
          docUrlInput.style.borderColor = '#16a34a';
          setTimeout(() => docUrlInput.style.borderColor = '', 1500);
        }
      });
    }

    function openFormModal(doc: DocItem | null = null) {
      if (!docFormModal || !docForm) return;
      const titleHeader = document.getElementById('doc-form-modal-title');
      if (doc) {
        if (titleHeader) titleHeader.textContent = "Edit Dokumen";
        (document.getElementById('doc-form-id') as HTMLInputElement).value = doc.id.toString();
        (document.getElementById('doc-form-title') as HTMLInputElement).value = doc.title;
        (document.getElementById('doc-form-category') as HTMLSelectElement).value = doc.category;
        (document.getElementById('doc-form-ext') as HTMLSelectElement).value = doc.ext;
        (document.getElementById('doc-form-date') as HTMLInputElement).value = doc.date;
        (document.getElementById('doc-form-content') as HTMLTextAreaElement).value = doc.content || '';
        if (docUrlInput) docUrlInput.value = doc.fileUrl || '';
      } else {
        if (titleHeader) titleHeader.textContent = "Tambah Dokumen";
        docForm.reset();
        (document.getElementById('doc-form-id') as HTMLInputElement).value = '';
        if (docUrlInput) docUrlInput.value = '';
        const dateInput = document.getElementById('doc-form-date') as HTMLInputElement;
        const today = new Date();
        const months = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agt", "Sep", "Okt", "Nov", "Des"];
        dateInput.value = `${today.getDate()} ${months[today.getMonth()]} ${today.getFullYear()}`;
      }
      docFormModal.showModal();
    }

    if (addDocBtn) addDocBtn.addEventListener('click', () => openFormModal(null));
    if (closeFormBtn) closeFormBtn.addEventListener('click', () => docFormModal?.close());

    if (docForm) {
      docForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const idVal = (document.getElementById('doc-form-id') as HTMLInputElement).value;
        const docId = idVal ? parseInt(idVal) : Date.now();
        const existingDoc = docsList.find(d => d.id === parseInt(idVal));
        
        let uploadedFileUrl = existingDoc ? existingDoc.fileUrl : '';

        // Handle URL input first if provided
        const manualUrl = docUrlInput?.value.trim();
        if (manualUrl) {
          uploadedFileUrl = convertDriveUrl(manualUrl, 'download');
        }

        // Convert file to base64 DataURL (works on static Vercel hosting) if file attached
        const file = fileInput?.files?.[0];
        let calcSize = existingDoc ? existingDoc.size : '1.2 MB';
        if (file) {
          calcSize = formatBytes(file.size);
          uploadedFileUrl = await new Promise<string>((resolve) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result as string);
            reader.onerror = () => resolve(uploadedFileUrl ?? '');
            reader.readAsDataURL(file);
          });
        }

        const entry: DocItem = {
          id: docId,
          title: (document.getElementById('doc-form-title') as HTMLInputElement).value,
          category: (document.getElementById('doc-form-category') as HTMLSelectElement).value,
          ext: (document.getElementById('doc-form-ext') as HTMLSelectElement).value,
          size: calcSize,
          date: (document.getElementById('doc-form-date') as HTMLInputElement).value,
          downloads: idVal ? existingDoc?.downloads || 0 : 0,
          content: (document.getElementById('doc-form-content') as HTMLTextAreaElement).value,
          fileUrl: uploadedFileUrl
        };

        // Upsert into localStorage cache immediately (optimistic)
        const cachedDocs = JSON.parse(localStorage.getItem('dmfk_docs') || 'null');
        const baseDocs: DocItem[] = cachedDocs || docsList;
        const dIdx = baseDocs.findIndex((d: any) => String(d.id) === String(entry.id));
        if (dIdx >= 0) baseDocs[dIdx] = entry; else baseDocs.push(entry);
        localStorage.setItem('dmfk_docs', JSON.stringify(baseDocs));
        // Sync to server and use server-returned list as source of truth
        try {
          const res = await fetch('/api/docs', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(entry)
          });
          if (res.ok) {
            const resData = await res.json();
            if (resData && Array.isArray(resData.docs)) {
              localStorage.setItem('dmfk_docs', JSON.stringify(resData.docs));
            }
          }
        } catch (_) {}
        docFormModal?.close();
        window.location.reload();
      });
    }
  }

  setupRepoInteractions();
  document.addEventListener('astro:after-swap', setupRepoInteractions);
</script>
